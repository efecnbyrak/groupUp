# ========================================================
# groupUp — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env   (.env ASLA commitlenmez)
# Doğrulama: src/lib/env.ts (zod) — eksik değişkende uygulama açılmaz
# ========================================================

# --- Uygulama ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
# openssl rand -base64 32
SESSION_SECRET=""

# --- Veritabanı (lokal PostgreSQL 19) ---
DATABASE_URL="postgresql://groupup:groupup_dev@localhost:5432/groupup"
DATABASE_URL_TEST="postgresql://groupup:groupup_dev@localhost:5432/groupup_test"
# Canlıda (Neon) pooled DATABASE_URL + migration için doğrudan bağlantı:
# DIRECT_URL=""

# --- Seed: Süper Admin ---
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# --- Mail ---
# smtp (Mailpit, lokal) | ses (canlı) | console (test)
MAIL_PROVIDER="smtp"
MAIL_FROM="groupUp <no-reply@groupup.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
# AWS SES (canlı)
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Dosya depolama ---
# local (./storage) | r2 (Cloudflare R2, canlı)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="groupup-public"
R2_PRIVATE_BUCKET="groupup-private"
R2_PUBLIC_BASE_URL=""

# --- Çeviri ---
# deepl | none (none: EN alanları boş kalır, arayüz TR gösterir)
TRANSLATION_PROVIDER="none"
DEEPL_API_KEY=""
DEEPL_API_URL="https://api-free.deepl.com"

# --- Cron ---
# openssl rand -base64 32
CRON_SECRET=""
