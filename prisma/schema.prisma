// groupUp veri modeli — taslak: docs/DATA-MODEL.md
// Modeller F2'den itibaren faz faz eklenir.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enum'lar (F2) — docs/DATA-MODEL.md §Enum'lar
// ============================================================
enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserType {
  STUDENT
  ALUMNI
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  PENDING_ALUMNI_REVIEW
  SUSPENDED
  DELETED
}

enum DomainType {
  STUDENT
  ALUMNI
}

enum AlumniVerifyMode {
  DOMAIN
  MANUAL
  BOTH
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  CHANGE_EMAIL
  DELETE_ACCOUNT
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
  BANNED
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StaffPermission {
  EVENT_MANAGE
  REGISTRATION_VIEW
  REGISTRATION_MANAGE
  TOURNAMENT_MANAGE
  MEMBER_INVITE
  ANNOUNCEMENT_POST
  TICKET_OPEN
}

enum ChangeRequestType {
  CLUB_UPDATE
  EVENT_PUBLISH
  EVENT_UPDATE
  EVENT_CANCEL
  MEMBER_REMOVE
  MEMBER_BAN
  STAFF_ASSIGN
  STAFF_REMOVE
  ALUMNI_VERIFY
  ELECTION_RESULT
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ParticipationMode {
  INDIVIDUAL
  TEAM
}

enum Eligibility {
  ALL_MEMBERS
  STUDENTS_ONLY
  ALUMNI_ONLY
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  DROPDOWN
  NUMBER
  DATE
  BOOLEAN
  FILE
  CONSENT
  SECTION
}

enum RegistrationStatus {
  APPLIED
  ACCEPTED
  WAITLISTED
  REJECTED
  CANCELLED
}

enum TournamentFormat {
  SINGLE_ELIM
  DOUBLE_ELIM
  ROUND_ROBIN
  GROUPS_KNOCKOUT
  SWISS
  FREE_FOR_ALL
}

enum StageType {
  KNOCKOUT
  DOUBLE_KNOCKOUT
  ROUND_ROBIN
  SWISS
  FFA
}

enum TournamentStatus {
  DRAFT
  SEEDED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WALKOVER
  POSTPONED
  BYE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketScope {
  CLUB_TO_ADMIN
  ADMIN_TO_PLATFORM
}

enum TicketCategory {
  EVENT
  APPROVAL
  MEMBERSHIP
  TOURNAMENT
  TECHNICAL
  OTHER
}

enum ElectionStatus {
  DRAFT
  CANDIDACY
  VOTING
  CLOSED
  RESULT_PENDING
  FINALIZED
  CANCELLED
}

// ============================================================
// Kimlik ve üniversite (F2) — sahip: university, identity, profile modülleri
// ============================================================
model University {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  city             String?
  logoKey          String?
  alumniVerifyMode AlumniVerifyMode @default(BOTH)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  domains   UniversityDomain[]
  faculties Faculty[]
  admins    UniversityAdmin[]
  users     User[]
  clubs     Club[]
  events    Event[]
}

model UniversityDomain {
  id           String     @id @default(cuid())
  universityId String
  domain       String     @unique // küçük harf, ör. "ogr.kent.edu.tr"
  type         DomainType

  university University @relation(fields: [universityId], references: [id])

  @@index([universityId])
}

model Faculty {
  id           String  @id @default(cuid())
  universityId String
  nameTr       String
  nameEn       String?

  university  University   @relation(fields: [universityId], references: [id])
  departments Department[]
  profiles    Profile[]

  @@unique([universityId, nameTr])
}

model Department {
  id        String  @id @default(cuid())
  facultyId String
  nameTr    String
  nameEn    String?

  faculty  Faculty   @relation(fields: [facultyId], references: [id])
  profiles Profile[]

  @@unique([facultyId, nameTr])
  @@index([facultyId])
}

model UniversityAdmin {
  id           String   @id @default(cuid())
  universityId String
  userId       String
  createdById  String?
  createdAt    DateTime @default(now())

  university University @relation(fields: [universityId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([universityId, userId])
  @@index([userId])
}

model UniversityRequest {
  id        String              @id @default(cuid())
  email     String
  name      String
  domain    String
  note      String?
  status    ChangeRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())

  @@index([status, createdAt])
}

model AlumniVerification {
  // Manuel mezun yolu (AUTH-EMAIL §6) — profile modülünün durum kaydı.
  // Belge: Attachment (approval), karar: ChangeRequest(ALUMNI_VERIFY) → changeRequestId son talebi gösterir.
  id              String              @id @default(cuid())
  userId          String              @unique
  universityId    String
  status          ChangeRequestStatus @default(PENDING)
  rejectReason    String?
  changeRequestId String?             @unique
  submittedAt     DateTime            @default(now())
  decidedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([universityId, status, submittedAt])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique // giriş maili, küçük harf
  emailVerifiedAt DateTime?
  passwordHash    String
  platformRole    PlatformRole @default(USER)
  type            UserType     @default(STUDENT)
  status          UserStatus   @default(PENDING_VERIFICATION)
  universityId    String? // Süper Admin için null olabilir
  locale          String       @default("tr")
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  university         University?         @relation(fields: [universityId], references: [id])
  profile            Profile?
  sessions           Session[]
  universityAdmin    UniversityAdmin[]
  alumniVerification AlumniVerification?
  presidentOf        Club?               @relation("ClubPresident")
  memberships        Membership[]
  staffRoles         StaffAssignment[]
  eventsCreated      Event[]             @relation("EventCreator")
  changeRequests     ChangeRequest[]     @relation("ChangeRequestRequester")
  eventRegistrations Registration[]
  teamsCaptain       Team[]              @relation("TeamCaptain")
  teamMemberships    TeamMember[]
  participantAs      Participant[]
  matchesUpdated     Match[]             @relation("MatchUpdatedBy")
  notifications      Notification[]
  candidacies        Candidate[]

  @@index([universityId, type])
}

model Profile {
  userId         String    @id
  firstName      String
  lastName       String
  studentNo      String?
  facultyId      String?
  departmentId   String?
  classYear      Int? // 0 = hazırlık, 1-6
  graduationYear Int?
  phone          String? // E.164
  gender         Gender?
  birthDate      DateTime? @db.Date
  avatarKey      String?
  bio            String?   @db.VarChar(300)
  kvkkConsentAt  DateTime

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([facultyId])
  @@index([departmentId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // sha256(token)
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String?
  email     String
  purpose   EmailTokenPurpose
  codeHash  String // sha256(OTP veya link token'ı)
  attempts  Int               @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([email, purpose])
  @@index([codeHash])
  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id // "login:ip:<hash>" / "otp:mail:x@y"
  count     Int
  windowEnd DateTime

  @@index([windowEnd])
}

model AuditLog {
  id           String   @id @default(cuid())
  universityId String?
  actorId      String?
  action       String // "identity.user.registered"
  targetType   String
  targetId     String
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([universityId, createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

// ============================================================
// Kategoriler (F4'te öne çekildi) — sahip: club (ClubCategory), event (EventCategory)
// ============================================================
model ClubCategory {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameTr String
  nameEn String
  icon   String? // lucide ikon adı
  order  Int     @default(0)

  clubs Club[]

  @@index([order])
}

model EventCategory {
  id       String  @id @default(cuid())
  parentId String?
  slug     String  @unique
  nameTr   String
  nameEn   String
  order    Int     @default(0)

  parent   EventCategory?  @relation("EventCategoryTree", fields: [parentId], references: [id])
  children EventCategory[] @relation("EventCategoryTree")
  events   Event[]

  @@index([parentId, order])
}

// ============================================================
// Kulüp, onay, ticket (F5) — sahip: club (Club..StaffAssignment), event (Announcement — F6), approval (ChangeRequest, Attachment), ticket
// ============================================================
model Club {
  id              String     @id @default(cuid())
  universityId    String
  categoryId      String
  slug            String     @unique // genel benzersiz: public /kulupler/[slug] üniversitesiz çözülür
  name            String
  shortDescTr     String     @db.VarChar(200)
  shortDescEn     String?    @db.VarChar(200)
  descriptionTr   Json? // Tiptap uyumlu doc (F5: yalnızca paragraflar)
  descriptionEn   Json?
  translationHash String?
  logoKey         String?
  coverKey        String?
  contactEmail    String?
  instagram       String?
  presidentId     String?    @unique // bir kişi tek kulüpte başkan
  status          ClubStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  university     University        @relation(fields: [universityId], references: [id])
  category       ClubCategory      @relation(fields: [categoryId], references: [id])
  president      User?             @relation("ClubPresident", fields: [presidentId], references: [id])
  memberships    Membership[]
  invites        ClubInvite[]
  staff          StaffAssignment[]
  announcements  Announcement[]
  changeRequests ChangeRequest[]
  tickets        Ticket[]
  events         Event[]
  elections      Election[]

  @@index([universityId, categoryId])
  @@index([universityId, status, name])
  @@index([categoryId])
}

model Membership {
  id          String           @id @default(cuid())
  clubId      String
  userId      String
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  bannedUntil DateTime? // BANNED + null = süresiz
  joinedVia   String? // "code" | "link" | "admin" | "president"

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, status, joinedAt])
}

model ClubInvite {
  id          String    @id @default(cuid())
  clubId      String
  code        String    @unique // 8 karakter, karışmayan alfabe
  createdById String
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([createdById])
}

model StaffAssignment {
  id          String            @id @default(cuid())
  clubId      String
  userId      String
  title       String            @db.VarChar(60)
  permissions StaffPermission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// ============================================================
// Seçim (F11) — sahip: election
// ============================================================
model Election {
  id                 String         @id @default(cuid())
  universityId       String
  clubId             String
  title              String         @db.VarChar(120)
  status             ElectionStatus @default(DRAFT)
  candidacyOpensAt   DateTime
  candidacyClosesAt  DateTime
  votingOpensAt      DateTime
  votingClosesAt     DateTime
  eligibleSnapshotAt DateTime? // seçmen listesi bu anda dondurulur
  winnerUserId       String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  club       Club            @relation(fields: [clubId], references: [id])
  candidates Candidate[]
  ballots    BallotReceipt[]
  votes      Vote[]

  @@index([clubId, status])
  @@index([universityId, status])
}

model Candidate {
  id          String   @id @default(cuid())
  electionId  String
  userId      String
  statementTr String?  @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId])
}

// KİM oy verdi (ne verdiği yok) — Vote ile aynı transaction'da, aralarında bağlantı yok (ELECTIONS §2).
model BallotReceipt {
  electionId String
  userId     String
  castAt     DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@id([electionId, userId])
}

// NE oy verildi (kim verdiği yok) — zaman damgası veya sıralı id YOK (zaman sızdırmasın diye rastgele uuid v4).
model Vote {
  id          String @id @default(uuid())
  electionId  String
  candidateId String

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, candidateId])
}

model Announcement {
  id              String   @id @default(cuid())
  clubId          String
  authorId        String
  titleTr         String
  titleEn         String?
  bodyTr          Json
  bodyEn          Json?
  pinned          Boolean  @default(false)
  translationHash String?
  createdAt       DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([authorId])
}

model ChangeRequest {
  id            String              @id @default(cuid())
  universityId  String
  clubId        String?
  type          ChangeRequestType
  targetId      String // clubId / eventId / userId ...
  payload       Json // tipine göre zod şeması
  reason        String?             @db.Text
  status        ChangeRequestStatus @default(PENDING)
  requestedById String
  reviewedById  String?
  decisionNote  String?             @db.Text
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  club        Club?        @relation(fields: [clubId], references: [id])
  requestedBy User         @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  attachments Attachment[]

  // + migration'da elle: aynı (type, targetId, clubId) için tek PENDING (kısmi unique index)
  @@index([universityId, status, createdAt])
  @@index([targetId, type, status])
  @@index([clubId, createdAt])
  @@index([requestedById])
}

model Attachment {
  id              String   @id @default(cuid())
  storageKey      String   @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  isPrivate       Boolean  @default(true)
  uploadedById    String
  changeRequestId String?
  ticketMessageId String?
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  ticketMessage TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@index([ticketMessageId])
  @@index([uploadedById])
}

model Ticket {
  id              String         @id @default(cuid())
  universityId    String
  clubId          String?
  scope           TicketScope
  category        TicketCategory @default(OTHER)
  subject         String         @db.VarChar(160)
  status          TicketStatus   @default(OPEN)
  openedById      String
  changeRequestId String?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  club     Club?           @relation(fields: [clubId], references: [id])
  messages TicketMessage[]

  @@index([universityId, scope, status, updatedAt])
  @@index([clubId, updatedAt])
  @@index([openedById])
  @@index([scope, status, updatedAt])
}

model TicketMessage {
  id          String       @id @default(cuid())
  ticketId    String
  authorId    String
  body        String       @db.Text
  createdAt   DateTime     @default(now())
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// ============================================================
// Etkinlik (F6) — sahip: event
// ============================================================
model Event {
  id                  String            @id @default(cuid())
  universityId        String
  clubId              String
  categoryId          String
  slug                String
  status              EventStatus       @default(DRAFT)
  titleTr             String            @db.VarChar(120)
  titleEn             String?           @db.VarChar(200)
  summaryTr           String            @db.VarChar(280)
  summaryEn           String?           @db.VarChar(500)
  descriptionTr       Json // Tiptap JSON
  descriptionEn       Json?
  translationHash     String?
  translatedAt        DateTime?
  enManual            Boolean           @default(false) // başkan EN'i elle düzeltti
  coverKey            String?
  locationName        String?           @db.VarChar(120)
  locationAddress     String?           @db.VarChar(300)
  mapUrl              String?           @db.VarChar(500)
  isOnline            Boolean           @default(false)
  onlineUrl           String?           @db.VarChar(500)
  startAt             DateTime?
  endAt               DateTime?
  applyOpensAt        DateTime?
  applyClosesAt       DateTime? // deadline (taslakta boş olabilir; onaya gönderirken zorunlu)
  capacity            Int? // null = sınırsız
  waitlistEnabled     Boolean           @default(true)
  autoPromoteWaitlist Boolean           @default(true)
  autoAccept          Boolean           @default(true)
  mode                ParticipationMode @default(INDIVIDUAL)
  teamMinSize         Int?
  teamMaxSize         Int?
  eligibility         Eligibility       @default(ALL_MEMBERS)
  publishedAt         DateTime?
  cancelledAt         DateTime?
  applyReminderSentAt DateTime? // F10 cron: deadline-reminder tekrar gönderilmesin
  startReminderSentAt DateTime? // F10 cron: event-reminder tekrar gönderilmesin
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  university    University       @relation(fields: [universityId], references: [id])
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category      EventCategory    @relation(fields: [categoryId], references: [id])
  createdBy     User             @relation("EventCreator", fields: [createdById], references: [id])
  images        EventImage[]
  formFields    EventFormField[]
  registrations Registration[]
  teams         Team[]
  tournaments   Tournament[]

  @@unique([clubId, slug])
  @@index([universityId, status, startAt])
  @@index([universityId, status, applyClosesAt])
  @@index([clubId, status, applyClosesAt])
  @@index([categoryId])
  @@index([createdById])
}

model EventImage {
  id      String  @id @default(cuid())
  eventId String
  key     String
  alt     String? @db.VarChar(200)
  order   Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, order])
}

// ============================================================
// Başvuru formu ve takımlar (F7) — sahip: event (EventFormField, Registration, Team, TeamMember)
// ============================================================
model EventFormField {
  id              String        @id @default(cuid())
  eventId         String
  type            FormFieldType
  order           Int
  labelTr         String        @db.VarChar(120)
  labelEn         String?       @db.VarChar(200)
  helpTr          String?       @db.VarChar(300)
  helpEn          String?       @db.VarChar(400)
  required        Boolean       @default(false)
  teamLevel       Boolean       @default(false) // takım modunda kaptan bir kez doldurur
  hidden          Boolean       @default(false) // başvuru varsa silinmez, yalnızca gizlenir (veri kaybı olmaz)
  options         Json? // seçim tipleri: [{value, labelTr, labelEn}]
  config          Json? // {maxLength, pattern, min, max, integer, accept, maxMb, minSelect, maxSelect, otherOption}
  showIfFieldId   String? // koşul: bu alan gösterildiğinde referans alan id'si (uygulama katmanında doğrulanır)
  showIfValue     Json?
  translationHash String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, order])
}

model Registration {
  id              String             @id @default(cuid())
  eventId         String
  userId          String
  teamId          String?
  status          RegistrationStatus @default(APPLIED)
  answers         Json // {fieldId: value}
  profileSnapshot Json // başvuru anındaki profil alanları (export için dondurulur)
  waitlistPos     Int?
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
  @@index([teamId])
}

model Team {
  id        String             @id @default(cuid())
  eventId   String
  name      String             @db.VarChar(50)
  code      String             @unique // 6 karakter, karışmayan alfabe
  captainId String
  status    RegistrationStatus @default(APPLIED)
  answers   Json // takım seviyesindeki alan cevapları
  lockedAt  DateTime? // kaptan "Başvuruyu tamamla" dedi veya kontenjan kararı verildi: yeni üye giremez
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  captain       User           @relation("TeamCaptain", fields: [captainId], references: [id])
  registrations Registration[]
  members       TeamMember[]
  participantAs Participant[]

  @@unique([eventId, name])
  @@index([eventId, status])
  @@index([captainId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ============================================================
// Turnuva (F8) — sahip: tournament (Tournament, Stage, TournamentGroup, Participant, Match)
// ============================================================
model Tournament {
  id          String           @id @default(cuid())
  eventId     String
  name        String           @db.VarChar(120)
  format      TournamentFormat
  status      TournamentStatus @default(DRAFT)
  settings    Json // puanlar, eşitlik bozma sırası, 3.lük maçı, çift devre, grup ayarları…
  isPublic    Boolean          @default(false)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stages       Stage[]
  participants Participant[]

  @@index([eventId])
}

model Stage {
  id           String    @id @default(cuid())
  tournamentId String
  order        Int
  type         StageType
  name         String    @db.VarChar(120) // "Grup Aşaması", "Eleme"
  settings     Json

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups     TournamentGroup[]
  matches    Match[]

  @@index([tournamentId, order])
}

model TournamentGroup {
  id      String @id @default(cuid())
  stageId String
  name    String @db.VarChar(40) // "A Grubu"
  order   Int    @default(0)

  stage        Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participants Participant[]
  matches      Match[]

  @@index([stageId, order])
}

model Participant {
  id           String    @id @default(cuid())
  tournamentId String
  teamId       String?
  userId       String?
  displayName  String    @db.VarChar(80)
  seed         Int?
  groupId      String?
  withdrawnAt  DateTime?

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  group      TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([groupId])
}

model Match {
  id          String      @id @default(cuid())
  stageId     String
  groupId     String?
  round       Int
  position    Int // tur içindeki sıra (braket çiziminde yukarıdan aşağı)
  groupKey    String? // "THIRD_PLACE" gibi aynı (round,position) alanı dışında özel maçlar için ayraç
  homeId      String? // Participant
  awayId      String?
  homeScore   Int?
  awayScore   Int?
  winnerId    String?
  status      MatchStatus @default(PENDING)
  nextMatchId String? // kazanan buraya
  nextSlot    String? // "home" | "away"
  scheduledAt DateTime?
  note        String?     @db.VarChar(300) // hükmen/erteleme gerekçesi
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  stage     Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group     TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("MatchUpdatedBy", fields: [updatedById], references: [id])

  @@index([stageId, round])
  @@index([groupId])
  @@index([nextMatchId])
}

enum NotificationType {
  APPROVAL_RESULT
  REGISTRATION_UPDATE
  TEAM_UPDATE
  MATCH_UPDATE
  TICKET_REPLY
  ELECTION
  ANNOUNCEMENT
  DEADLINE_REMINDER
  SYSTEM
}

/**
 * Uygulama içi bildirim (F10). Mail ayrı gönderilir (notification/emails) — ikisi birlikte tetiklenir.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleTr   String
  titleEn   String
  bodyTr    String?
  bodyEn    String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
